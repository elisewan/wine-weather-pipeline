# Checkpoint / cache files (these are big and regenerate when you run the code)
*.pkl
weather_cache_checkpoint.pkl

# Data files (these are too large for GitHub and you can regenerate them)
*.csv
vivino_top_ten_with_region_weather*.csv

# Python cache files (don't need to track these)
__pycache__/
*.pyc

# Jupyter notebook checkpoints (auto-generated by Jupyter)
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environment files (don't share your personal setup)
.env
.venv/
venv/

# VS Code settings (optional, personal preference)
.vscode/

# OS junk files (Mac/Windows system files)
.DS_Store
Thumbs.db
